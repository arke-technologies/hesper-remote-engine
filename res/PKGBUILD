pkgname=hesper-remote-engine
pkgver=1.4.8
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=('rustdesk' 'hesper-remote')
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/hesper-remote-engine" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/hesper-remote-engine"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/hesper-remote-engine/hesper-remote-engine usr/bin/hesper-remote-engine && popd
  install -Dm 644 $HBB/res/hesper-remote-engine.service -t "${pkgdir}/usr/share/hesper-remote-engine/files"
  install -Dm 644 $HBB/res/hesper-remote-engine.desktop -t "${pkgdir}/usr/share/hesper-remote-engine/files"
  install -Dm 644 $HBB/res/hesper-remote-engine-link.desktop -t "${pkgdir}/usr/share/hesper-remote-engine/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hesper-remote-engine.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/hesper-remote-engine.svg"
}
