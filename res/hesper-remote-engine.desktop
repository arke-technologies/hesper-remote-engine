[Desktop Entry]
Name=Hesper Remote
GenericName=Remote Desktop
Comment=Remote Desktop
Exec=hesper-remote-engine %u
Icon=hesper-remote-engine
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=remote-desktop;remote-control;remote-access;remote-support;rdp;vnc;
Actions=new-window;
StartupWMClass=hesper-remote-engine

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=hesper-remote-engine %u
