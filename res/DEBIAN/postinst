#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/hesper-remote-engine/hesper-remote-engine /usr/bin/hesper-remote-engine

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/hesper-remote-engine.service ]; then
			rm /etc/systemd/system/hesper-remote-engine.service /usr/lib/systemd/system/hesper-remote-engine.service /usr/lib/systemd/user/hesper-remote-engine.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/hesper-remote-engine/files/systemd/hesper-remote-engine.service /usr/lib/systemd/system/hesper-remote-engine.service
		# try fix error in Ubuntu 18.04
		# Failed to reload hesper-remote-engine.service: Unit hesper-remote-engine.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/hesper-remote-engine.service:10: Executable path is not absolute: pkill -f "hesper-remote-engine --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/hesper-remote-engine.service
		fi
		systemctl daemon-reload
		systemctl enable hesper-remote-engine
		systemctl start hesper-remote-engine

		# Rebrand cleanup. The pre-rebrand packages installed a rustdesk-named
		# unit, binary symlink and PAM service. dpkg removes their package files,
		# but conffiles and the unit's enable symlink survive — so a fleet upgrade
		# would otherwise keep an /etc/pam.d/rustdesk pointing at a binary that no
		# longer exists, plus an enabled-but-dead rustdesk unit.
		rm -f /usr/lib/systemd/system/rustdesk.service \
		      /lib/systemd/system/rustdesk.service \
		      /etc/systemd/system/rustdesk.service
		if [ -L /usr/bin/rustdesk ]; then rm -f /usr/bin/rustdesk; fi
		rm -f /etc/pam.d/rustdesk
		systemctl daemon-reload || true
	fi

	# Refresh the desktop/MIME cache so the x-scheme-handler/{hesperremote,rustdesk}
	# associations declared in hesper-remote-engine-link.desktop take effect at
	# once. Without this the "Start session" deep link shows "No Apps Available"
	# until some other event rebuilds the cache. Guarded + non-fatal so a missing
	# tool never breaks the install (set -e is active).
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications || true
	fi
fi
