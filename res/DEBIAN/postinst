#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/hesper-remote-engine/hesper-remote-engine /usr/bin/hesper-remote-engine

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/hesper-remote-engine.service ]; then
			rm /etc/systemd/system/hesper-remote-engine.service /usr/lib/systemd/system/hesper-remote-engine.service /usr/lib/systemd/user/hesper-remote-engine.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/hesper-remote-engine/files/systemd/hesper-remote-engine.service /usr/lib/systemd/system/hesper-remote-engine.service
		# try fix error in Ubuntu 18.04
		# Failed to reload hesper-remote-engine.service: Unit hesper-remote-engine.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/hesper-remote-engine.service:10: Executable path is not absolute: pkill -f "hesper-remote-engine --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/hesper-remote-engine.service
		fi
		systemctl daemon-reload
		systemctl enable hesper-remote-engine
		systemctl start hesper-remote-engine
	fi
fi
