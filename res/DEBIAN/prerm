#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/hesper-remote-engine

		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop hesper-remote-engine >/dev/null 2>&1 || true
			systemctl disable hesper-remote-engine >/dev/null 2>&1 || true
			rm -f /etc/systemd/system/hesper-remote-engine.service /usr/lib/systemd/system/hesper-remote-engine.service

			# workaround temp dev build between 1.1.9 and 1.2.0
			serverUser=$(ps -ef | grep -E 'hesper-remote-engine +--server' | grep -v 'sudo ' | awk '{print $1}' | head -1)
			if [ "$serverUser" != "" ] && [ "$serverUser" != "root" ]
			then
				systemctl --machine=${serverUser}@.host --user stop hesper-remote-engine >/dev/null 2>&1 || true
			fi
			rm /usr/lib/systemd/user/hesper-remote-engine.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
